# Postgres connection string (Vercel Postgres / Neon)
DATABASE_URL=
# OpenAI API key (the agent uses GPT-6 Luna)
OPENAI_API_KEY=
# Password for signing in to the app
APP_PASSWORD=
# Optional: secret for signing sessions and agent confirmations (defaults to a hash of DATABASE_URL)
# SESSION_SECRET=
# Optional: override the model id (default: gpt-6-luna)
# OPENAI_MODEL=gpt-6-luna
